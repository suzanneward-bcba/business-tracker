rules_version = '2';

// Only the Google accounts listed below can read or write anything.
// To add a second user later, add their email (lowercase) to the list
// and publish the rules again.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAllowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'suzanneward@adaptability.co'
        ];
    }

    match /workspaces/{document=**} {
      allow read, write: if isAllowed();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
